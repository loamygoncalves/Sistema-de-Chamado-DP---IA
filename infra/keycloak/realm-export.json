{
  "realm": "beep",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "beep-ai-service-desk",
      "name": "BEEP AI Service Desk",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "secret": "change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8000/api/v1/auth/callback",
        "https://operacoes-playground.internal.beepsaude.com.br/api/v1/auth/callback"
      ],
      "webOrigins": ["http://localhost:3000", "https://operacoes-playground.internal.beepsaude.com.br"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "clientScopes": [
    {
      "name": "matricula",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "matricula-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "matricula",
            "claim.name": "matricula",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "beep-roles",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": ["profile", "email", "matricula", "beep-roles"],
  "roles": {
    "realm": [
      { "name": "employee", "description": "Colaborador BEEP" },
      { "name": "analyst", "description": "Analista de atendimento" },
      { "name": "department_lead", "description": "Líder de área" },
      { "name": "admin", "description": "Administrador da plataforma" }
    ]
  },
  "users": [
    {
      "id": "a1a1a1a1-0000-4000-8000-000000000001",
      "username": "colaborador.demo",
      "email": "colaborador.demo@beepsaude.com.br",
      "firstName": "Colaborador",
      "lastName": "Demo",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "beep123", "temporary": false }],
      "realmRoles": ["employee"],
      "attributes": { "matricula": ["10001"] }
    },
    {
      "id": "a1a1a1a1-0000-4000-8000-000000000002",
      "username": "analista.demo",
      "email": "analista.demo@beepsaude.com.br",
      "firstName": "Analista",
      "lastName": "Demo",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "beep123", "temporary": false }],
      "realmRoles": ["analyst"],
      "attributes": { "matricula": ["20001"] }
    },
    {
      "id": "a1a1a1a1-0000-4000-8000-000000000003",
      "username": "admin.demo",
      "email": "admin.demo@beepsaude.com.br",
      "firstName": "Admin",
      "lastName": "Demo",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "beep123", "temporary": false }],
      "realmRoles": ["admin"],
      "attributes": { "matricula": ["30001"] }
    }
  ]
}

# === Backend ===
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://beep:beep@postgres:5432/beep_service_desk
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=beep_knowledge_base
EMBEDDING_DIM=1536

AUTH_PROVIDER=keycloak
OIDC_ISSUER=http://keycloak:8080/realms/beep
OIDC_CLIENT_ID=beep-ai-service-desk
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

DEFAULT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

CONFIDENCE_THRESHOLD_AUTO=0.85
CONFIDENCE_THRESHOLD_SUGGEST=0.60
RAG_TOP_K=6
CHAT_HISTORY_MAX_MESSAGES=12

S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=beep-service-desk
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Sincronização automática da base de conhecimento com uma pasta do Google
# Drive (arquivos novos/alterados são reingeridos a cada N minutos pelo
# Celery Beat). Requer uma conta de serviço do Google com a pasta
# compartilhada (papel "Leitor") com o client_email do JSON.
# Passo a passo completo de configuração: docs/GOOGLE_DRIVE_SETUP.md
GOOGLE_DRIVE_SYNC_ENABLED=false
# Pasta "SISTEMA DE CHAMADO - IA" (id extraído da URL /folders/<id>).
GOOGLE_DRIVE_FOLDER_ID=18EaKrwmBOTLZ1bKQ-_iC_F7_sUM6CB65
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
GOOGLE_DRIVE_DEFAULT_DEPARTMENT_SLUG=
DRIVE_SYNC_INTERVAL_MINUTES=15

CORS_ORIGINS=["http://localhost:3000"]

# === Frontend ===
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="BEEP AI Service Desk"

# === Keycloak (dev) ===
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

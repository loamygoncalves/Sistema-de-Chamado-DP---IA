# === Backend ===
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://beep:beep@postgres:5432/beep_service_desk
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=beep_knowledge_base
EMBEDDING_DIM=1536

AUTH_PROVIDER=keycloak
OIDC_ISSUER=http://keycloak:8080/realms/beep
OIDC_CLIENT_ID=beep-ai-service-desk
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

DEFAULT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Amazon Bedrock (alternativa a ANTHROPIC_API_KEY/OPENAI_API_KEY quando rodando
# na AWS — usa a role IAM da task/instância, sem chave separada). Para usar,
# troque DEFAULT_LLM_PROVIDER e/ou EMBEDDING_PROVIDER acima para "bedrock".
# Passo a passo completo: docs/AWS_DEPLOYMENT.md
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

CONFIDENCE_THRESHOLD_AUTO=0.85
CONFIDENCE_THRESHOLD_SUGGEST=0.60
RAG_TOP_K=6
CHAT_HISTORY_MAX_MESSAGES=12

S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=beep-service-desk
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Sincronização automática da base de conhecimento com uma pasta local ou de
# rede — 100% local e sem custo, sem depender de nenhuma API externa. Arquivos
# .txt e .pdf são lidos diretamente da pasta a cada resposta da IA (arquivos
# sem mudança são pulados). Deixe LOCAL_KNOWLEDGE_FOLDER em branco para
# desativar. Passo a passo: docs/LOCAL_KNOWLEDGE_SETUP.md
LOCAL_KNOWLEDGE_FOLDER=/data/knowledge-base
LOCAL_KNOWLEDGE_DEFAULT_DEPARTMENT_SLUG=

# Alternativa (ou complemento) à pasta local: sincronização com uma pasta do
# Google Drive via API, usando uma service account — não depende do
# computador de ninguém estar ligado, funciona de qualquer lugar onde o
# backend rodar (local ou AWS). Passo a passo: docs/GOOGLE_DRIVE_SETUP.md
GOOGLE_DRIVE_FOLDER_ID=18EaKrwmBOTLZ1bKQ-_iC_F7_sUM6CB65
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_DEFAULT_DEPARTMENT_SLUG=

# Notificação por e-mail (chamado aberto/respondido/finalizado). Desativado
# por padrão — sem EMAIL_NOTIFICATIONS_ENABLED=true e SMTP_HOST configurados,
# o envio é pulado silenciosamente (nunca impede abrir/responder/encerrar).
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=dp@beepsaude.com.br

CORS_ORIGINS=["http://localhost:3000"]

# === Frontend ===
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="BEEP AI Service Desk"

# === Keycloak (dev) ===
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
